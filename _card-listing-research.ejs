<%
// Research section listing. Receives all topics and keeps only those whose
// `category:` field — split on `&` and trimmed — contains "research".
// Rendering logic is inlined (mirrors _card-listing.ejs) because EJS includes
// don't behave reliably under Quarto's template runner.

const targetCategory = 'research';

const displayItems = items.filter(it => {
  const cats = String(it.category || '').split('&').map(s => s.trim()).filter(Boolean);
  return cats.includes(targetCategory);
});

const jitter = [92, 86, 98, 88, 95, 89, 84, 96, 91, 87, 94, 85];

const rows = [];
let i = 0;
while (i < displayItems.length) {
  const a = displayItems[i];
  if (a['card-size'] === 'full') {
    rows.push([a]);
    i += 1;
  } else {
    const b = displayItems[i + 1];
    if (b && b['card-size'] !== 'full') {
      rows.push([a, b]);
      i += 2;
    } else {
      rows.push([a]);
      i += 1;
    }
  }
}
%>

<% if (rows.length === 0) { %>
<p><em>No topics yet.</em></p>
<% } else { %>
<div class="cards-grid">
<% rows.forEach((row, idx) => { %>
<div class="card-row" style="--row-width: <%= jitter[idx % jitter.length] %>%;">
<% row.forEach(it => {
     const size = it['card-size'] || '';
     const sizeClass = size ? ('card-' + size) : '';
%>
<details class="card <%= sizeClass %>">
<summary>
<% if (it.thumbnail) {
     const dir = (it.path || '').replace(/\/[^\/]+$/, '/');
%>
<span class="card-thumb has-image"><img src="<%= dir + it.thumbnail %>" alt="<%= it['card-thumb-label'] || it['card-summary'] || '' %>"></span>
<% } else { %>
<span class="card-thumb"><%= it['card-thumb-label'] || '' %></span>
<% } %>
<span class="card-question"><%- it['card-summary'] || it.title || '' %></span>
</summary>
<div class="card-body">
<p><%- it['card-detail'] || '' %></p>
<p><a class="card-readmore" href="<%= it.path %>">Read more →</a></p>
</div>
</details>
<% }); %>
</div>
<% }); %>
</div>
<% } %>
